{
  "name": "mejora-suite",
  "version": "0.1.0",
  "description": "Sede independiente de MejoraSuite — lanza MejoraCRM, MejoraContactos y MejoraWS sin fusionar su código.",
  "type": "module",
  "main": "electron/main.mjs",
  "author": "Pablo - Mejora Continua",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mejoracontinua.mejorasuite",
    "productName": "MejoraSuite",
    "files": [
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/brand/icon.ico"
    }
  }
}
