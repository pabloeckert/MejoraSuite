# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Set to "false" to use real Supabase auth (default: true = demo mode)
VITE_DEMO_MODE=true

# Google Calendar Integration
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-google-api-key

# ─────────────────────────────────────────────────────────────────────
# Sincronización con MejoraContactos (persona_id / contactos_finales)
# ─────────────────────────────────────────────────────────────────────
# Estas NO van en este .env -- viven en dos lugares distintos, ninguno
# es este archivo. Documentadas acá solo para que quede claro que existen
# y dónde configurarlas. Ver INFORME-SINCRONIZACION-CONTACTOS.md para el
# paso a paso completo.
#
# 1) Supabase → este proyecto → Project Settings → Edge Functions → Secrets:
#      CONTACTOS_API_URL   URL de la función contactos-api de MejoraContactos
#      CONTACTOS_API_KEY   token de escritura para MejoraCRM (puede_escribir=true)
#      CRON_SECRET         secreto propio para autenticar al workflow de GitHub Actions
#
# 2) GitHub → este repo → Settings → Secrets and variables → Actions:
#      SUPABASE_FUNCTIONS_URL   https://<project-ref>.functions.supabase.co
#      SUPABASE_ANON_KEY        la misma que VITE_SUPABASE_PUBLISHABLE_KEY de arriba
#      CRON_SECRET              el mismo valor que en el paso 1
